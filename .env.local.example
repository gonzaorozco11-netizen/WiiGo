# Copiá este archivo a .env.local para desarrollo local (no hace falta si solo vas a usar la app en producción vía Vercel)

# Panel de Supabase → Project Settings → Data API
SUPABASE_URL=https://tu-proyecto.supabase.co

# Panel de Supabase → Project Settings → API Keys → service_role (secreta, nunca la compartas)
SUPABASE_SERVICE_ROLE_KEY=

# Una cadena aleatoria larga, solo para firmar la sesión (no hace falta recordarla)
AUTH_SECRET=

# Los mails a las marcas (avisos de venta, de agotado, de solicitud resuelta).
# Sin RESEND_API_KEY no sale ningún mail: el intento queda registrado en la
# tabla `avisos_enviados` con ok=false y el motivo. Es lo que pasa en local si
# no la ponés acá, aunque en Vercel esté configurada.
# Panel de resend.com → API Keys
RESEND_API_KEY=

# Quién figura como remitente. Con el dominio sin verificar solo se puede usar
# onboarding@resend.dev, que únicamente le llega al dueño de la cuenta de
# Resend y cae en spam. Para que las marcas reciban de verdad hace falta un
# dominio propio verificado en Resend.
MAIL_DESDE=WiiGo <onboarding@resend.dev>

# El dominio con el que se arman los links y el logo de los mails. En Vercel
# sale solo; acá conviene ponerlo para que las imágenes del mail no salgan
# rotas al probar en local.
APP_URL=
