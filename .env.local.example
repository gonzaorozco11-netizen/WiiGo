# Copiá este archivo a .env.local para desarrollo local (no hace falta si solo vas a usar la app en producción vía Vercel)

# Panel de Supabase → Project Settings → Data API
SUPABASE_URL=https://tu-proyecto.supabase.co

# Panel de Supabase → Project Settings → API Keys → service_role (secreta, nunca la compartas)
SUPABASE_SERVICE_ROLE_KEY=

# Una cadena aleatoria larga, solo para firmar la sesión (no hace falta recordarla)
AUTH_SECRET=
